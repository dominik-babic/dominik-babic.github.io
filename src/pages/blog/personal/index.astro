---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IndexEntry from "../../../components/IndexEntry.astro";
import ToggleNav from "../../../components/ToggleNav.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const allBlogs = await getCollection("blog");
const blogs = allBlogs
    .filter((b: BlogEntry) => b.data.type === "personal")
    .sort((a: BlogEntry, b: BlogEntry) =>
        b.data.date.getTime() - a.data.date.getTime()
    );

const allTags = [...new Set(blogs.flatMap((b: BlogEntry) => b.data.tags || []))].sort();

const toggleOptions = [
    { label: "Tech", href: "/blog/tech" },
    { label: "Personal", href: "/blog/personal" },
];
---
<BaseLayout title="Blog — Dominik Babić" description="Writing on running, life, and everything in between." accent="personal">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
        <div>
            <h1 data-no-toggle-anim class="font-serif text-4xl font-bold tracking-tight mb-2 fade-in-up">Blog</h1>
            <p class="text-muted fade-in-up">Writing on running, life, and everything in between.</p>
        </div>
        <ToggleNav options={toggleOptions} active="/blog/personal" transitionName="blog-toggle" class="self-start" />
    </div>

    {blogs.length > 0 ? (
        <>
            <div class="mb-6 fade-in-up delay-100">
                <div class="flex flex-wrap items-center gap-2 mb-3" role="group" aria-label="Filter posts by tag">
                    <span class="font-mono text-xs uppercase tracking-widest text-faint mr-1">filter</span>
                    <button class="filter-btn active" data-filter="all" aria-pressed="true">
                        all ({blogs.length})
                    </button>
                    {allTags.map(tag => {
                        const count = blogs.filter((b: BlogEntry) => b.data.tags?.includes(tag)).length;
                        return (
                            <button class="filter-btn" data-filter={tag} aria-pressed="false">
                                {tag} ({count})
                            </button>
                        );
                    })}
                </div>
                <span id="results-count" class="font-mono text-xs text-faint" aria-live="polite">{blogs.length} post{blogs.length !== 1 ? "s" : ""} found</span>
            </div>

            <div id="blogs-grid" class="border-t border-line fade-in-up delay-200">
                {blogs.map((blog: BlogEntry) => (
                    <IndexEntry
                        title={blog.data.title}
                        description={blog.data.description}
                        date={blog.data.date}
                        link={`/blog/${blog.id}`}
                        hasDetailPage={true}
                        tags={blog.data.tags}
                        image={blog.data.image}
                    />
                ))}
            </div>

            <div id="no-results" class="hidden py-16 text-center fade-in-up">
                <p class="font-mono text-sm text-faint">// no posts match that tag</p>
            </div>

            <script>
                import { initFilter } from '../../../scripts/filterGrid';
                initFilter({
                    itemSelector: '.entry',
                    gridId: 'blogs-grid',
                    noResultsId: 'no-results',
                    resultsCountId: 'results-count',
                    labelSingular: 'post',
                    labelPlural: 'posts',
                });
            </script>
        </>
    ) : (
        <div class="py-20 text-center fade-in-up">
            <p class="font-mono text-sm text-faint">// nothing here yet — race reports are on their way</p>
        </div>
    )}
</BaseLayout>
