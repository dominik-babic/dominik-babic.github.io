---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IndexEntry from "../../components/IndexEntry.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type ProjectEntry = CollectionEntry<"projects">;

const projects = await getCollection("projects");
projects.sort((a: ProjectEntry, b: ProjectEntry) =>
    b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(projects.flatMap((p: ProjectEntry) => p.data.tags || []))].sort();
---
<BaseLayout title="Projects — Dominik Babić" description="ML, cybersecurity and research work, together with personal projects.">
    <div class="fade-in-up mb-8">
        <h1 class="font-serif text-4xl font-bold tracking-tight mb-3">Projects</h1>
        <p class="text-muted max-w-[62ch]">ML, cybersecurity and research work, together with personal projects.</p>
    </div>

    <div class="mb-6 fade-in-up delay-100">
        <div class="flex flex-wrap items-center gap-2 mb-3" role="group" aria-label="Filter projects by tag">
            <span class="font-mono text-xs uppercase tracking-widest text-faint mr-1">filter</span>
            <button class="filter-btn active" data-filter="all" aria-pressed="true">
                all ({projects.length})
            </button>
            {allTags.map((tag) => {
                const count = projects.filter((p: ProjectEntry) => p.data.tags?.includes(tag)).length;
                return (
                    <button class="filter-btn" data-filter={tag} aria-pressed="false">
                        {tag} ({count})
                    </button>
                );
            })}
        </div>
        <span id="results-count" class="font-mono text-xs text-faint" aria-live="polite">{projects.length} projects found</span>
    </div>

    <div id="projects-grid" class="border-t border-line fade-in-up delay-200">
        {projects.map((project: ProjectEntry) => (
            <IndexEntry
                title={project.data.title}
                description={project.data.description}
                date={project.data.date}
                github={project.data.github}
                hasDetailPage={project.data.hasDetailPage}
                link={`/projects/${project.id}`}
                tags={project.data.tags}
                image={project.data.image}
            />
        ))}
    </div>

    <div id="no-results" class="hidden py-16 text-center fade-in-up">
        <p class="font-mono text-sm text-faint">// no projects match that tag</p>
    </div>

    <script>
        import { initFilter } from '../../scripts/filterGrid';
        initFilter({
            itemSelector: '.entry',
            gridId: 'projects-grid',
            noResultsId: 'no-results',
            resultsCountId: 'results-count',
            labelSingular: 'project',
            labelPlural: 'projects',
        });
    </script>
</BaseLayout>
