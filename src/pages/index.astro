---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndexEntry from "../components/IndexEntry.astro";
import { inlineMd } from "../scripts/inlineMd";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const projects = await getCollection("projects");
const featured = projects
    .filter((p: CollectionEntry<"projects">) => p.data.featured)
    .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
        b.data.date.getTime() - a.data.date.getTime());

const blogs = await getCollection("blog");
const featuredBlogs = blogs
    .filter((b: CollectionEntry<"blog">) => b.data.featured)
    .sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
        b.data.date.getTime() - a.data.date.getTime());

const tips = await getCollection("tips");
tips.sort((a: CollectionEntry<"tips">, b: CollectionEntry<"tips">) =>
    b.data.date.getTime() - a.data.date.getTime()
);
// Show the tip matching the build month; fall back to the most recent one.
// A monthly scheduled rebuild in CI keeps this fresh (see .github/workflows/astro.yml).
const now = new Date();
const currentMonthTip = tips.find((t: CollectionEntry<"tips">) => {
    const d = t.data.date;
    return d.getUTCFullYear() === now.getUTCFullYear() && d.getUTCMonth() === now.getUTCMonth();
});
const latestTip = currentMonthTip ?? tips[0] ?? null;
const tipLabel = currentMonthTip ? "Tip of the month" : "Latest tip";
---
<BaseLayout title="Dominik Babić">
    <!-- Hero -->
    <section class="pt-4 pb-12 fade-in-up">
        <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight">Dominik Babić</h1>
        <p class="mt-4 font-mono text-xs uppercase tracking-[0.2em] text-faint">
            AI engineer · computer vision · distance runner
        </p>
        <p class="mt-5 text-muted leading-relaxed max-w-[62ch]">
            An archive of findings, projects and notes — machine learning, security,
            self-hosting, and the occasional race report.
        </p>
    </section>

    {latestTip && (
        <section class="mb-14 fade-in-up delay-100" aria-label={tipLabel}>
            <div class="border-y border-line py-5">
                <div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-widest">
                    <span class="w-1.5 h-1.5 bg-pop inline-block" aria-hidden="true"></span>
                    <span class="text-faint">{tipLabel}</span>
                    <span class="text-accent">{latestTip.data.category}</span>
                </div>
                <h2 class="font-serif text-lg font-semibold mt-3">{latestTip.data.title}</h2>
                <p class="md-inline text-sm text-muted leading-relaxed mt-1.5" set:html={inlineMd(latestTip.data.summary)} />
            </div>
        </section>
    )}

    <!-- Featured projects -->
    <section class="mb-14 fade-in-up delay-200">
        <div class="flex items-baseline gap-3 mb-1">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">01</span>
            <h2 class="font-serif text-2xl font-semibold">Selected projects</h2>
            <a href="/projects" class="ml-auto font-mono text-xs text-muted hover:text-accent transition-colors duration-150">all →</a>
        </div>
        <div>
            {featured.map((project: CollectionEntry<"projects">) => (
                <IndexEntry
                    title={project.data.title}
                    description={project.data.description}
                    date={project.data.date}
                    github={project.data.github}
                    link={`/projects/${project.id}`}
                    hasDetailPage={project.data.hasDetailPage}
                    tags={project.data.tags}
                    image={project.data.image}
                />
            ))}
        </div>
    </section>

    <!-- Featured writing -->
    <section class="fade-in-up delay-300">
        <div class="flex items-baseline gap-3 mb-1">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">02</span>
            <h2 class="font-serif text-2xl font-semibold">Selected writing</h2>
            <a href="/blog/tech" class="ml-auto font-mono text-xs text-muted hover:text-accent transition-colors duration-150">all →</a>
        </div>
        <div>
            {featuredBlogs.map((blog: CollectionEntry<"blog">) => (
                <IndexEntry
                    title={blog.data.title}
                    description={blog.data.description}
                    date={blog.data.date}
                    link={`/blog/${blog.id}`}
                    hasDetailPage={true}
                    tags={blog.data.tags}
                    image={blog.data.image}
                />
            ))}
        </div>
    </section>
</BaseLayout>
